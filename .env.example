# Copy this file to .env and fill in the values. Never commit .env.

# Claude (Anthropic) API key: console.anthropic.com > API keys
ANTHROPIC_API_KEY=
# Model used for resume reading and tailoring. Default: claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5

# Firebase web app config (public values): Firebase console > Project settings > Your apps > Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Random long string that signs login cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Postgres connection (Fly.io) for deploy. Leave empty locally: a local database in .data/ is used.
DATABASE_URL=

# Local only: shows a "Dev login" button so the app works before Firebase is set up. Never set in production.
DEV_LOGIN=1
